REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost:5432
POSTGRES_DB=crawler

# Category validation (ValidateCategory step). Leave ML_CATEGORY_HOST empty to
# skip it. Set it to the crawler-ml-category /predict URL to re-classify each
# freshly-crawled product and correct keyword_id / comodity_id when the model
# disagrees with the search keyword.
ML_CATEGORY_HOST=
ML_CATEGORY_WINDOW_HOURS=24
ML_CATEGORY_CONCURRENCY=8
ML_CATEGORY_TIMEOUT_MS=5000
